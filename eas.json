{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_ANALYSIS_URL": "https://gym-tracker-analysis.gym-tracker-analysis-worker.workers.dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_ANALYSIS_URL": "https://gym-tracker-analysis.gym-tracker-analysis-worker.workers.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_ANALYSIS_URL": "https://gym-tracker-analysis.gym-tracker-analysis-worker.workers.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
