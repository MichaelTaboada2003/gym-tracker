# URL de tu Worker de Cloudflare (ver worker/README.md).
# NO es un secreto: es solo un endpoint, y va dentro del APK a propósito.
# En local, con `cd worker && npx wrangler dev --port 8790`: http://localhost:8790
EXPO_PUBLIC_ANALYSIS_URL=

# Opcional. Debe coincidir con el APP_TOKEN del Worker.
# EXPO_PUBLIC_ANALYSIS_TOKEN=
